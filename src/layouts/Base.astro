---
import '../styles/global.css';
import site from '../data/site.json';
import { href } from '../lib/posts';
interface Props { home?: boolean; title?: string; description?: string; active?: string; noindex?: boolean }
const { title, description = site.description, active = '', noindex = false, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.title}` : site.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={href('rss.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href={href()} aria-label={site.title + ' home'}>{home ? 'English edition' : site.title}</a>
      <nav aria-label="Main navigation">
        <a href={href('archive/')} aria-current={active === 'archive' ? 'page' : undefined}>Archive</a>
        <a href={href('about/')} aria-current={active === 'about' ? 'page' : undefined}>About</a>
        <a href={href('subscribe/')} aria-current={active === 'subscribe' ? 'page' : undefined}>RSS</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <span>© {new Date().getUTCFullYear()} {site.title}</span>
      <a href={href('rss.xml')}>RSS feed</a>
    </footer>
  </body>
</html>
