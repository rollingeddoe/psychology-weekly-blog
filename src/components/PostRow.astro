---
import type { CollectionEntry } from 'astro:content';
import { href, formatDate } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
---
<article class="post-row" data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
  <div class="post-meta"><span class="eyebrow">{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
  <div class="post-summary"><h3><a href={href(`posts/${post.id}/`)}>{post.data.title}<span class="row-arrow" aria-hidden="true">↗</span></a></h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></div>
</article>
