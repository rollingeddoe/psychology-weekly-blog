---
import type { CollectionEntry } from 'astro:content';
import { href, formatDate } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
---
<article class="post-row" data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
  <div class="post-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>{post.data.category}{post.data.issue ? ` · No. ${post.data.issue}` : ''}</span>
  </div>
  <div class="post-summary">
    <h3><a href={href(`posts/${post.id}/`)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
  </div>
</article>
