---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, href, formatDate } from '../../lib/posts';
export async function getStaticPaths() { return (await publishedPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <header class="article-heading narrow">
    <div class="meta">{post.data.category}{post.data.issue ? ` · Issue ${post.data.issue}` : ''}</div>
    <h1>{post.data.title}</h1>
    <p class="article-deck">{post.data.description}</p>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
  </header>
  <div class="article-layout wrap">
    {headings.some(h => h.depth === 2) && <aside class="margin-note"><h2>Contents</h2><nav aria-label="Article sections">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}
    <article class="prose"><Content /><p class="article-end"><a href={href('archive/')}>All writing</a></p></article>
  </div>
</Base>
