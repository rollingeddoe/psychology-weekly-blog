---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, href, formatDate } from '../../lib/posts';
export async function getStaticPaths() { return (await publishedPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <header class="article-heading wrap"><a class="back-link" href={href('archive/')}>← All writing</a><div class="eyebrow">{post.data.category}{post.data.issue ? ` · Issue ${String(post.data.issue).padStart(2, '0')}` : ''}</div><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></header>
  <div class="reading-layout wrap"><aside class="margin-note"><span class="eyebrow">In this article</span><nav aria-label="Article sections">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside><article class="prose"><Content /><div class="article-end"><span aria-hidden="true">✳</span><p>More questions. More reading.</p><a href={href('archive/')}>Back to the archive →</a></div></article></div>
</Base>
