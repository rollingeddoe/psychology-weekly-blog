---
import Base from '../layouts/Base.astro';
import { href } from '../lib/posts';
const feed = new URL(href('rss.xml'), Astro.site).href;
---
<Base title="Follow by RSS" active="subscribe">
  <section class="page-heading narrow"><h1>Follow by RSS</h1></section>
  <article class="prose narrow stand-alone">
    <p>To receive each new article, add this address to your feed reader.</p>
    <div class="feed-box"><code id="feed-url">{feed}</code><button id="copy-feed" type="button">Copy feed URL</button></div>
    <p id="copy-status" class="small" role="status" aria-live="polite"></p>
    <p><a href={href('rss.xml')}>Open the feed</a></p>
  </article>
</Base>
<script>
  document.querySelector('#copy-feed')!.addEventListener('click', async () => {
    const status = document.querySelector('#copy-status')!;
    try { await navigator.clipboard.writeText(document.querySelector('#feed-url')!.textContent!); status.textContent = 'Copied. Paste this address into your feed reader.'; }
    catch { status.textContent = 'Copy the address above and paste it into your feed reader.'; }
  });
</script>
