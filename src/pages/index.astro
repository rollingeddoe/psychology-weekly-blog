---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { publishedPosts, href } from '../lib/posts';
import site from '../data/site.json';
const posts = await publishedPosts();
---
<Base home>
  <section class="masthead wrap" aria-labelledby="masthead-title">
    <div>
      <h1 id="masthead-title">{site.title}</h1>
      <p>{site.description}</p>
    </div>
    <figure>
      <img src={href('duck-rabbit.png')} width="918" height="570" alt="An engraved head that can be seen as a duck facing left or a rabbit facing right." />
      <figcaption><a href="https://commons.wikimedia.org/wiki/File:PSM_V54_D328_Optical_illusion_of_a_duck_or_a_rabbit_head_(cropped).png">Duck–rabbit, 1899</a></figcaption>
    </figure>
  </section>
  <section class="latest wrap" aria-labelledby="latest-heading">
    <div class="section-heading"><h2 id="latest-heading">Latest writing</h2><a href={href('archive/')}>Full archive</a></div>
    {posts.slice(0, 4).map(post => <PostRow post={post} />)}
    {posts.length === 0 && <p class="empty-state">The first issue is in preparation. <a href={href('subscribe/')}>Follow by RSS</a>.</p>}
  </section>
</Base>
